# Copy to .env.local and fill in for your Supabase project (local or hosted).
#
# Without these set, the app runs exactly as it did in Phase 1 — no login
# wall, still localStorage-backed (see proxy.ts). Route protection and the
# login page only activate once these are configured.

# Public — safe in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix this with NEXT_PUBLIC_ — it bypasses Row Level
# Security entirely. Used only by scripts/bootstrap-admin.ts and
# scripts/migrate-clients-to-supabase.ts; nothing under app/ imports it.
SUPABASE_SERVICE_ROLE_KEY=

# Explicit data-source mode, not auto-detected — "demo" or "supabase".
# "demo" (the default when unset, outside production): clients (and every
# other entity) stay in this browser's localStorage, exactly as in Phase 1/2.
# "supabase": clients are read from/written to Supabase; requires
# NEXT_PUBLIC_SUPABASE_URL/ANON_KEY to also be set — if they're missing or
# invalid, the app fails closed with a clear error screen, it never silently
# falls back to localStorage. In a production build (NODE_ENV=production),
# leaving this unset or setting an invalid value is itself a startup error —
# there is no implicit default once real users are involved. This flag is a
# development/testing tool for exercising both backends side by side, not a
# rollback mechanism.
NEXT_PUBLIC_DATA_BACKEND=demo

# Default OFF. Driver Licenses and Medical Documents stay hidden from the
# Documents page (both the folder picker and "All Documents") until agency
# counsel/compliance confirms the applicable storage/retention requirements
# and explicitly approves turning this on (see lib/config.ts). Enabling it
# is meant to be a one-line, deliberate config flip after that sign-off —
# not something that happens by default in any environment, including
# production.
NEXT_PUBLIC_ENABLE_SENSITIVE_DOCUMENT_FOLDERS=false
